# ── App environment ─────────────────────────────────────────────
# "development" | "staging" | "production"
# Controls whether GA4 loads and whether MEDIA_PROVIDER=mock is allowed.
NEXT_PUBLIC_APP_ENV=development

# Public site URL, used for canonical URLs, sitemap, robots.txt, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Media provider ──────────────────────────────────────────────
# "mock" for local development and testing.
# In production, this must be set to an approved, configured provider -
# see src/providers/index.ts. MEDIA_PROVIDER=mock is rejected at runtime
# when NEXT_PUBLIC_APP_ENV=production.
MEDIA_PROVIDER=mock

# Timeout (ms) for a single provider request before we return a
# "timeout" error to the user.
PROVIDER_TIMEOUT_MS=10000

# ── Analytics ────────────────────────────────────────────────────
# Leave unset to disable GA4 entirely (e.g. in development).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Rate limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
MAX_REQUEST_BYTES=2000

# ── Advertising ──────────────────────────────────────────────────
# Reserves ad slot space in the layout without loading any ad network.
# Leave "false" until an approved advertising provider is integrated.
NEXT_PUBLIC_ADS_ENABLED=false

# ── Cloudflare Turnstile (optional bot protection, Phase 8) ──────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
